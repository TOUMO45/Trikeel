# TRIKEEL VAULT — example
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# Commit ONLY this example file, with names and placeholder values.
# The agent may reference these NAMES. It must never print or commit the VALUES.
# Every name here must also appear in STUDY.md → "Env contract".

# --- App ---
APP_ENV=development
APP_PORT=3000

# --- Datastore ---
DATABASE_URL=postgres://user:password@localhost:5432/appdb

# --- Third-party services ---
EXAMPLE_API_KEY=replace-me
EXAMPLE_WEBHOOK_SECRET=replace-me
